# =============================================================
# BOT DE TELEGRAM PARA SORTEOS - Configuracion
# Copia este archivo como .env y completa los valores
# =============================================================

# Token del bot (obtenlo de @BotFather en Telegram)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# IDs de administradores separados por comas (usa @userinfobot para obtener tu ID)
ADMIN_IDS=123456789,987654321

# Base de datos (SQLite por defecto, PostgreSQL recomendado para produccion)
DATABASE_URL=sqlite:///raffle_bot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/raffle_bot

# Pagos de Telegram (obtenlo de @BotFather con /mybots > Payments)
# Deja vacio para modo demo (sin cobros reales)
PAYMENT_PROVIDER_TOKEN=

# Moneda para pagos (ISO 4217)
CURRENCY=USD

# Precio del ticket en USD
TICKET_PRICE_USD=1.00

# Tickets ganados por ver un anuncio
TICKETS_PER_AD=1

# Tiempo de espera entre anuncios (en segundos, default: 3600 = 1 hora)
AD_COOLDOWN_SECONDS=3600

# Configuracion de anuncios
AD_URL_1=https://tu-sitio-de-anunciante.com
AD_IMAGE_URL_1=
AD_DURATION_SECONDS=10
